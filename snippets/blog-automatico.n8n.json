      "parameters": {
        "jsCode": "function limpiarSlug(s) {\n  return String(s || '')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '')\n    .slice(0, 80);\n}\nfunction elegirFoto() {\n  const fuentes = [\"Buscar imagen Unsplash\", \"Unsplash respaldo 1\", \"Unsplash respaldo 2\"];\n  for (const nombre of fuentes) {\n    try { const r = $(nombre).first().json.results; if (r && r.length) { return r[0]; } } catch (e) {}\n  }\n  return null;\n}\nconst post = $(\"Validar y parsear\").item.json.post; const topic = $(\"Validar y parsear\").item.json.topic; const img = elegirFoto(); const faqs = Array.isArray(post.faqs) ? post.faqs : []; const base = (img && img.user && img.user.links && img.user.links.html) ? img.user.links.html : \"https://images.example.com\"; const autorUrl = base + \"?utm_source=tu_marca&utm_medium=referral\"; const payload = { titulo: post.titulo, slug: limpiarSlug(post.slug || post.titulo), meta_title: post.meta_title, meta_description: post.meta_description, categoria: post.categoria, extracto: post.extracto, cuerpo_html: post.cuerpo_html, faqs: faqs, servicio_relacionado: post.servicio_relacionado, imagen_query: post.imagen_query, imagen_alt: post.imagen_alt || (img ? img.alt_description : \"\") || post.titulo, imagen_url: img ? img.urls.regular : \"\", imagen_url_small: img ? img.urls.small : \"\", imagen_autor: (img && img.user) ? img.user.name : \"\", imagen_autor_url: autorUrl }; return [{ json: { payload: payload, topic: topic } }];"
      },
