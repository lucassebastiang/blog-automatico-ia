      "parameters": {
        "jsCode": "const r = $input.first().json; var post = null; var reason = \"\"; try { post = JSON.parse(r.choices[0].message.content); } catch (e) { reason = \"JSON no parseable\"; } const req = [\"titulo\",\"slug\",\"meta_title\",\"meta_description\",\"categoria\",\"extracto\",\"cuerpo_html\",\"imagen_query\",\"imagen_alt\",\"servicio_relacionado\"]; if (post) { for (const k of req) { if (!post[k] || String(post[k]).trim() === \"\") { reason = \"Falta el campo \" + k; break; } } } if (post && (!Array.isArray(post.faqs) || post.faqs.length < 1)) { reason = \"Faltan las FAQs\"; } var words = 0; if (post && post.cuerpo_html) { words = String(post.cuerpo_html).replace(/<[^>]+>/g, \" \").split(/\\s+/).filter(Boolean).length; } if (post && reason === \"\" && words < 900) { reason = \"Articulo demasiado corto: \" + words + \" palabras\"; } const bad = [\"como modelo de lenguaje\",\"no puedo\",\"lo siento\",\"as an ai\",\"language model\"]; if (post && reason === \"\") { const low = (post.titulo + \" \" + post.cuerpo_html).toLowerCase(); for (const b of bad) { if (low.indexOf(b) !== -1) { reason = \"Frase prohibida: \" + b; break; } } } const valid = Boolean(post) && reason === \"\"; return [{ json: { valid: valid, reason: reason, post: post, topic: $(\"Coger tema pendiente\").item.json } }];"
      },
