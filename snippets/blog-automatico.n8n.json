      "parameters": {
        "jsCode": "function elegirFoto() {\n  const fuentes = [\"Buscar imagen Unsplash\", \"Unsplash respaldo 1\", \"Unsplash respaldo 2\"];\n  for (const nombre of fuentes) {\n    try { const r = $(nombre).first().json.results; if (r && r.length) { return r[0]; } } catch (e) {}\n  }\n  return null;\n}\nconst img = elegirFoto();\nconst u = (img && img.urls && (img.urls.raw || img.urls.full)) || '';\nif (!u) { throw new Error('Unsplash no devolvió foto para Instagram'); }\nconst sep = u.includes('?') ? '&' : '?';\nreturn [{ json: { imageUrl: u + sep + 'w=1080&h=1080&fit=crop&q=85&auto=format' } }];"
      },
