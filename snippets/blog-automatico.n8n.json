        "jsCode": "const nl = String.fromCharCode(10); const post = $(\"Validar y parsear\").first().json.post; const url = \"https://www.example.com/blog/\" + $(\"Construir payload\").first().json.payload.slug + \"/\"; const payload = $(\"Construir payload\").first().json.payload; const cat = String(post.categoria || \"\").toLowerCase(); let tags = \"#TuMarca #TuCiudad #pymes\"; if (cat.indexOf(\"web\") !== -1) { tags = \"#DiseñoWeb #PáginaWeb #pymes #TuCiudad\"; } else if (cat.indexOf(\"automat\") !== -1) { tags = \"#AutomatizaciónIA #InteligenciaArtificial #pymes #TuCiudad\"; } else if (cat.indexOf(\"brand\") !== -1) { tags = \"#Branding #DiseñoDeMarca #pymes #TuCiudad\"; } else if (cat.indexOf(\"seo\") !== -1) { tags = \"#SEO #MarketingDigital #pymes #TuCiudad\"; } else if (cat.indexOf(\"manten\") !== -1) { tags = \"#MantenimientoWeb #WPO #pymes #TuCiudad\"; } const linkedin = post.titulo + nl + nl + post.extracto + nl + nl + \"Lo contamos entero en el blog 👉 \" + url + nl + nl + tags; const facebook = post.titulo + nl + nl + post.extracto + nl + nl + \"👉 \" + url; const instagram = post.titulo + nl + nl + post.extracto + nl + nl + \"Artículo completo en el enlace de la bio 👉 www.example.com/blog\" + nl + nl + tags; const articuloHtml = String(post.cuerpo_html || \"\").replace(/href=\"\\//g, \"href=\\\"https://www.example.com/\"); return [{ json: { linkedin: linkedin, facebook: facebook, titulo: post.titulo, url: url, imagenUrl: payload.imagen_url, articuloHtml: articuloHtml, instagram: instagram } }];"
